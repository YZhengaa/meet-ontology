     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:void="http://rdfs.org/ns/void#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://w3id.org/pmd/co/meet/meet-base.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/pmd/co/meet/releases/2026-11-11/meet-base.owl"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/IAO_8000001"/>
        <dc:creator>Khashayar Razghandi</dc:creator>
        <dc:creator>Markus Schilling</dc:creator>
        <dc:creator>Yuan Zheng</dc:creator>
        <dc:description>The Materials Experimental and Testing Data Exchange (MEET) Ontology is an application-level ontology built upon the Platform MaterialDigital Core Ontology (PMDco) to support interoperable, FAIR, and multi-contextual materials data exchange. It reuses and connects concepts from established ontologies while introducing application-specific concepts and semantic patterns for representing materials research data, processes, information objects, contexts, provenance, and their relationships. MEET aims to harmonize heterogeneous materials metadata, connect distributed research information, enable semantic validation, and facilitate consistent data exchange and reuse across research environments and digital infrastructures. It provides a semantic foundation for data-centric applications throughout the materials data lifecycle.</dc:description>
        <dc:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by/4.0/</dc:license>
        <dc:title>Materials Experimental and Testing Data Exchange (MEET) Ontology</dc:title>
        <owl:versionInfo>0.0.1</owl:versionInfo>
        <owl:versionInfo>2026-11-11</owl:versionInfo>
    </owl:Ontology>
    


