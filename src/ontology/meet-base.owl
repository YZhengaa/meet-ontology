<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/pmd/co/meet/meet-base.owl#"
     xml:base="https://w3id.org/pmd/co/meet/meet-base.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
