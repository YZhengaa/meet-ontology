AnnotationAssertion(rdfs:label obo:CHEBI_24431 "chemical entity")
SubClassOf(obo:CHEBI_24431 obo:BFO_0000040)

# Class: obo:CHEBI_59999 (chemical substance)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_59999 "A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types.")
AnnotationAssertion(rdfs:comment obo:CHEBI_59999 "Frequently used for fluidic portions of matter and/or in the context of chemical reactions. Boundary to material not always sharp."@en)
