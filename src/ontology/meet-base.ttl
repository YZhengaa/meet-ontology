<https://w3id.org/pmd/co/meet/meet-base.ttl> rdf:type owl:Ontology ;
                                              owl:versionIRI <https://w3id.org/pmd/co/meet/releases/2026-11-11/meet-base.ttl> ;
                                              <http://purl.org/dc/elements/1.1/creator> "Khashayar Razghandi" ,
                                                                                        "Markus Schilling" ,
                                                                                        "Yuan Zheng" ;
                                              <http://purl.org/dc/elements/1.1/description> "The Materials Experimental and Testing Data Exchange (MEET) Ontology is an application-level ontology built upon the Platform MaterialDigital Core Ontology (PMDco) to support interoperable, FAIR, and multi-contextual materials data exchange. It reuses and connects concepts from established ontologies while introducing application-specific concepts and semantic patterns for representing materials research data, processes, information objects, contexts, provenance, and their relationships. MEET aims to harmonize heterogeneous materials metadata, connect distributed research information, enable semantic validation, and facilitate consistent data exchange and reuse across research environments and digital infrastructures. It provides a semantic foundation for data-centric applications throughout the materials data lifecycle." ;
                                              <http://purl.org/dc/elements/1.1/license> "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
                                              <http://purl.org/dc/elements/1.1/title> "Materials Experimental and Testing Data Exchange (MEET) Ontology" ;
                                              <http://purl.org/dc/elements/1.1/type> obo:IAO_8000001 ;
                                              owl:versionInfo "0.0.1" ,
                                                              "2026-11-11" .

