    "@language" : "en",
    "@value" : "relationship between a planned process and the plan specification that it carries out; it is defined as equivalent to the composed relationship (realizes o concretizes)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "executes"
  } ],
