}, {
  "@id" : "http://purl.obolibrary.org/obo/CHEBI_59999",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@value" : "A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Frequently used for fluidic portions of matter and/or in the context of chemical reactions. Boundary to material not always sharp."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "chemical substance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CHEBI_24431"
  }, {
    "@id" : "https://w3id.org/pmd/co/PMD_0000001"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CHEBI_60003",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@value" : "A pure substance is a chemical substance composed of multiple molecules, which are all of the same kind."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "pure substance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CHEBI_59999"
  } ]
}, {
