  }, {
    "@id" : "_:genid65"
  }, {
    "@id" : "_:genid66"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/OBI_0000070",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A planned process that has the objective to produce information about a material entity (the evaluant) by examining it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "assay"
