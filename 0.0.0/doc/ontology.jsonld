  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "An information content entity that specifies a value within a classification scheme or on a quantitative scale."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "value specification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000030"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/OBI_0001937",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A relation between a value specification and a number that quantifies it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OBI_0001933"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has specified numeric value"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OBI_0002135"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/OBI_0002135",
