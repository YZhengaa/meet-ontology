    "@id" : "_:genid88"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/OBI_0000260",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A plan is a realizable entity that is the inheres in a bearer who is committed to realizing it as a completely executed planned process."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "plan"
