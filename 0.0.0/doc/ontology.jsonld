  "@id" : "http://purl.obolibrary.org/obo/OBI_0000293",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@value" : "The inverse property of is specified input of"
  } ],
